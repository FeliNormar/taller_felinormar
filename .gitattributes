# Configuración de Git para el proyecto

# Normalización de finales de línea
* text=auto

# Archivos Python
*.py text eol=lf

# Archivos de configuración
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Scripts de shell
*.sh text eol=lf
*.bat text eol=crlf

# Archivos HTML/CSS/JS
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf

# Archivos binarios
*.db binary
*.sqlite binary
*.sqlite3 binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
