# Configuración de ejemplo para producción
# Copia este archivo como .env y configura tus valores

# IMPORTANTE: Genera una clave secreta aleatoria para producción
# Puedes usar: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=tu-clave-super-secreta-aqui-cambiar-en-produccion

# Entorno de ejecución
FLASK_ENV=production

# Base de datos (opcional, por defecto usa instance/taller_felinormar.db)
# DATABASE_URL=/ruta/absoluta/a/base/de/datos.db

# Puerto (opcional, por defecto 5000)
# PORT=5000
