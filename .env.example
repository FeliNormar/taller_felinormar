# ============================================================
# Variables de entorno — Taller Felinormar
# Copia este archivo como .env para desarrollo local
# NUNCA subas el .env real a Git
# ============================================================

# OBLIGATORIO: Clave secreta para sesiones Flask
# Genera una con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esto-por-una-clave-segura-generada

# Entorno: development | production
FLASK_ENV=development

# Ruta de la base de datos (opcional, usa instance/ por defecto)
# DATABASE_PATH=/ruta/absoluta/taller_felinormar.db

# Puerto (Render lo asigna automáticamente)
# PORT=5000

# Email para recuperación de contraseña (Gmail SMTP)
MAIL_USERNAME=tu_correo@gmail.com
MAIL_PASSWORD=xxxx xxxx xxxx xxxx
